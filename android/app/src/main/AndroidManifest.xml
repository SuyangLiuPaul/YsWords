<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 2026-09-05: INTERNET, declared here ON PURPOSE.

         It was never declared by the app. The release APK had network
         anyway, by manifest merge: `google_sign_in_android` declares
         INTERNET in its own manifest and the merger folded it in.
         `build/app/intermediates/manifest_merge_blame_file/intlRelease/
         processIntlReleaseMainManifest/manifest-merger-blame-intl-release-report.txt`
         blames line 42 on `[:google_sign_in_android]` and on nothing
         else. It is the only Android plugin this app resolves that
         declares INTERNET — the other two carrying it in the pub cache,
         google_mobile_ads 5.1.0 and 8.0.0, are not dependencies here.

         So every network feature — the songs catalogue, the sermon
         MP3s, Firebase, the illustration CDN — hung off a permission
         contributed by the sign-in plugin. Drop or replace that plugin
         and the app loses ALL network on Android with a green build and
         a green analyze: nothing fails at compile time, and
         `flutter analyze` does not read manifests. It would not even
         reproduce while developing, because `debug` and `profile`
         declare INTERNET themselves (the stock Flutter template layout)
         and only `main` did not.

         This exact failure cost the sibling app Yahweh's World three
         releases. Pinned by `test/android_internet_permission_test.dart`.
         Do not delete it because "the merged manifest already has it" —
         that is the bug, not the reason it is redundant. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 2026-05-21 (v1.2.69): runtime notification permission for
         Android 13+ (TIRAMISU). Older Android grants by default. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 2026-08-09 (Songs player): background audio via audio_service.
         Android stops playback when the app leaves the foreground
         unless it runs as a foreground service, so listening while
         driving needs these. FOREGROUND_SERVICE_MEDIA_PLAYBACK is the
         typed permission Android 14+ requires alongside the generic
         one; WAKE_LOCK keeps the CPU alive between buffer refills. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
            2026-05-24 (v1.2.97): themed launcher icon variants.
            Each <activity-alias> below targets MainActivity but
            ships its own android:icon. Exactly ONE alias (or the
            main activity) is enabled at a time via PackageManager.
            setComponentEnabledSetting from the
            yswords/android_icon MethodChannel (see MainActivity).
            When the user picks a primaryColor in Settings →
            AppIconService.updateForColor → channel
            invokeMethod("setIcon", "Red") → Kotlin enables
            `.AliasRed` and disables the rest.

            UX caveats:
              - Launcher icon swap takes ~1-3 s on most launchers;
                the app may briefly disappear from the grid while
                Android re-indexes. Some launchers refuse to refresh
                until reboot.
              - 2026-06-16 (v1.3.85): the swap is applied in
                MainActivity.onStop(), NOT the instant the colour
                changes. Disabling the component the running task is
                rooted on FINISHES that task (DONT_KILL_APP only
                spares the process) — doing it in the foreground made
                the app "quit" on every colour change. Deferring to
                onStop means the launcher shows the new icon once the
                user leaves the app, and the activity is never killed.
              - Aliases must hold the LAUNCHER intent filter or
                they won't surface in the launcher; that requires
                android:exported="true" (Android 12+).
        -->
        <activity-alias
            android:name=".AliasRed"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_red">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasOrange"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_orange">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasGreen"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_green">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasPurple"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_purple">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasPink"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_pink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasDark"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- 2026-08-09 (Songs player): audio_service's playback service
             and media-button receiver. The service must declare
             foregroundServiceType="mediaPlayback" or Android 14+
             refuses to start it; the receiver is what routes headset
             and steering-wheel buttons to the player, which is the
             difference between "plays in the car" and "plays in the
             car but you cannot skip a track without unlocking". -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
