.dart_tool/
.packages
.pub-cache/
build/
# 2026-05-09 (v1.2.0): China-mode bundle lives in build-cn/ so the
# international build/ and China build-cn/ can sit side-by-side
# without overwriting each other on every `flutter build`.
build-cn/
.flutter-plugins
.flutter-plugins-dependencies
.idea/
.vscode/
*.iml
.DS_Store
*.log
# 2026-05-09: pubspec.lock IS committed (Flutter app, not a package
# — apps need reproducible installs across local + CI). Keep .lock
# wildcard ignore for everything else though (e.g. package-lock,
# yarn.lock from sibling repos accidentally landing here).
*.lock
!pubspec.lock
.env
.netlify/
ljk-nt-bible-webapp

# Dev artifact regenerated by scan_folder.py — kept out of VCS
lib_source_dump.txt

# tools/build_originals.py download cache — regeneratable, ~50 MB
.cache/

# Local agent dev settings (preview launch config, etc.)
.claude/

# Cloud Functions local deps (installed via `cd functions && npm install`).
functions/node_modules/
# Bundled at deploy time only — sourced from assets/bible_evidence.json.
functions/bible_evidence.json

# Backup files from one-off data migration scripts.
*.bak
assets/*.bak
lib/**/*.bak

functions/package-lock.json

# Netlify Functions install their own deps locally; bundler picks
# them up at deploy time. Keep node_modules out of git.
netlify/functions/node_modules/
netlify/functions/package-lock.json
.netlify/
build-wasm/
tools/__pycache__/
scripts/__pycache__/
# test/ gained Python tests on 2026-09-05 (the sermon-library fetcher), so it
# grew a __pycache__ too. A stale one there already caused a mutation run to
# report results that lagged an iteration by one.
test/__pycache__/

# The 940-record sermon library fetched from fuyindiantai.org.
#
# Deliberately NOT tracked. It was committed on 2026-09-06 and pushed to
# this PUBLIC repo before the question it carries had been answered:
# `_meta.authorisedBy` records a relayed permission that the owner gave
# about the SONGS on those domains, not about redistributing 5.4 million
# characters of 71 preachers' sermons. The bodies are public on
# fuyindiantai.org, so this was never a confidentiality problem — it is a
# REDISTRIBUTION one, and it is the church's call, not ours.
#
# Regenerate locally with `python3 scripts/sync_sermon_library.py`. The
# fetcher and its 130 tests stay in the repo; only the fetched content
# leaves. Untrack again if it is ever re-added by accident.
assets/sermon_library/
