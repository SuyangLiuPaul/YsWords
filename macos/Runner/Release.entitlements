<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- 2026-05-21 (v1.2.68): outbound HTTPS for Firebase Auth +
	     Firestore + Google Sign-In. Without this, sandboxed macOS
	     app can't reach googleapis.com / firebaseio.com etc. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- 2026-05-22 (v1.2.71): keychain access for Firebase Auth +
	     google_sign_in. Sandboxed apps need keychain-access-groups
	     even for their OWN bundle's keychain; without it,
	     credential storage fails with "an error occurred when
	     accessing the keychain". Requires DEVELOPMENT_TEAM to be
	     set in the Runner build config (YC5JZD3DY7). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.example.yswords</string>
	</array>
	<!-- 2026-09-09 (review finding 2): the verse-card photo picker.
	     image_picker on macOS goes through file_selector_macos, i.e.
	     NSOpenPanel, and a sandboxed app is only allowed to READ the
	     file the reader chose in that panel if it holds
	     user-selected.read-only. Without it the panel still opens and
	     still returns a path — but readAsBytes on that path is
	     refused, so the picker looked like it worked and the card
	     never got the picture. Read-only on purpose: nothing here
	     writes back to the camera roll. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
