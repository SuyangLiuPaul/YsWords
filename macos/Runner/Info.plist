<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 2026-05-21 (v1.2.68): URL scheme registration for the
	     Google OAuth callback used by signInWithProvider on macOS.
	     REVERSED_CLIENT_ID matches the value in
	     macos/Runner/GoogleService-Info.plist (which is shared with
	     iOS since both targets use the same bundle ID). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.461522287670-ndij2tes352rk5rqek76ect2m1hv6i7d</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>Yahweh's Words</string>
	<!-- 2026-09-01: CFBundleName is the name macOS puts in the MENU BAR
	     (the bold item next to ), and it was $(PRODUCT_NAME) — which
	     AppInfo.xcconfig still sets to the Flutter scaffold's `yswords`.
	     So Finder and the Dock said "Yahweh's Words" from
	     CFBundleDisplayName above while the menu bar said "yswords",
	     the only surface left disagreeing with the others.

	     Set literally rather than by fixing PRODUCT_NAME: PRODUCT_NAME
	     also names the built bundle (`yswords.app`) and is referenced by
	     three TEST_HOST paths in Runner.xcodeproj/project.pbxproj and
	     four BuildableName entries in the shared xcscheme. Renaming it
	     is build-system surgery, and it buys nothing a user can see once
	     this key is explicit. -->
	<key>CFBundleName</key>
	<string>Yahweh's Words</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
