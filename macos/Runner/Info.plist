<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 2026-05-21 (v1.2.68): URL scheme registration for the
	     Google OAuth callback used by signInWithProvider on macOS.
	     REVERSED_CLIENT_ID matches the value in
	     macos/Runner/GoogleService-Info.plist (which is shared with
	     iOS since both targets use the same bundle ID). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.461522287670-ndij2tes352rk5rqek76ect2m1hv6i7d</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>Yahweh's Words</string>
	<!-- 2026-09-01: CFBundleName is the name macOS puts in the MENU BAR
	     (the bold item next to ), and it was $(PRODUCT_NAME) — which
	     AppInfo.xcconfig set to the Flutter scaffold's `yswords`. So
	     Finder and the Dock said "Yahweh's Words" from
	     CFBundleDisplayName above while the menu bar said "yswords",
	     the only surface left disagreeing with the others.

	     2026-09-18: PRODUCT_NAME has since been renamed after all — to
	     `Yahwehs-Words`, so the downloaded zip expands to a bundle with
	     the app's name on it rather than another app's. The surgery the
	     note below called for was done with it: three TEST_HOST paths in
	     project.pbxproj and four BuildableName entries in the shared
	     xcscheme. These two keys stay spelled out regardless —
	     PRODUCT_NAME names a FILE, and `Yahwehs-Words` is not what
	     belongs in the menu bar. -->
	<key>CFBundleName</key>
	<string>Yahweh's Words</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
